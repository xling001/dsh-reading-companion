{
  "name": "dsh-reading-companion",
  "version": "3.1.8",
  "description": "DSH 本地书架 + AI 陪读插件（Novel companion）：导入本地 TXT、自动生成目录、按进度滚动阅读，并以「不剧透」的书友口吻陪你聊感想，把「原文摘抄—我的感想—AI 回应」写成结构化 Markdown 笔记。A local shelf with a spoiler-safe AI reading companion (Novel companion) for DeepSeek Harness (DSH).",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "reader",
    "ebook",
    "txt",
    "reading-companion",
    "notes"
  ],
  "license": "MIT",
  "author": "溪泠",
  "contributors": [
    {
      "name": "溪泠"
    },
    {
      "name": "AI (DSH coding agent)",
      "url": "https://github.com/deepseek-ai"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xling001/dsh-reading-companion.git"
  },
  "homepage": "https://github.com/xling001/dsh-reading-companion#readme",
  "bugs": {
    "url": "https://github.com/xling001/dsh-reading-companion/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "dsh-better-sidebar": ">=0.19.0"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs/design.md",
    "docs/publishing.md",
    "docs/background-format.md",
    "scripts/reindex-books.mjs",
    "cordis.patch.yml",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "npm run clean:test-tmp && node --test",
    "test:no-isolation": "npm run clean:test-tmp && node --test --test-isolation=none",
    "clean:test-tmp": "node -e \"require('node:fs').rmSync('test/.tmp',{recursive:true,force:true})\"",
    "guard:census": "node scripts/guard-census.mjs",
    "rebuild:library-index": "node scripts/rebuild-library-index.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
